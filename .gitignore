# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environments
.venv/
.venv-*/
venv/
env/

# Logs and scratch outputs
logs/
debug/
*.log
test_output.txt
*.tmp
*.temp
.coverage
htmlcov/
.*-pytest-temp*/
temp_*.yaml
*.tar.gz
*.zip
FINAL_SUBMISSION_PACKAGE/

# Generated research data and model artifacts. Keep only the small, canonical
# CSV fixture and provenance manifests needed for a clean-clone reproduction.
data/**
!data/examples/
!data/examples/sample_prices.csv
!data/manifests/
!data/manifests/**
!data/cache/
!data/cache/ohlcv/
!data/cache/ohlcv/*.parquet

# Training and evaluation outputs
/models/
reports/
.experiment_state/
*.pt
!exports/research_defense_bundle/models/*.pt
!paper/internal/evidence/research_defense_extract/raw_experimental_evidence/models/*.pt
!exports/CORE_RL_V4_VERIFIED_GOVERNANCE_PACKAGE/models/*.pt
!paper/internal/evidence/research_defense_extract/v4_annual_252_evidence/models/*.pt
*.pth
*.ckpt
*.d3
*.parquet
!data/cache/ohlcv/*.parquet
*.npz
*.npy
*.pkl
*.pickle
graphify-out/

# Compact, publication-grade evidence is intentionally tracked. Large binary
# artifacts remain ignored even inside this directory via the global patterns.
!reports/
reports/*
!reports/research_evidence/
!reports/research_evidence/**

# Local OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
